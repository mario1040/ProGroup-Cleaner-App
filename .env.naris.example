# Copy to .env.naris. Use a long random hexadecimal password (letters/numbers only).
NARIS_DB_USER=naris_app
NARIS_DB_PASSWORD=REPLACE_WITH_RANDOM_48_CHAR_HEX
NARIS_WEB_PORT=8081

# Production: add the exact public origin, e.g. https://cleaner.example.com
APP_ALLOWED_ORIGINS=http://localhost:8081
APP_TIME_ZONE=Africa/Cairo
PG_POOL_MAX=10

# Keep disabled until Firestore import and same-date task reconciliation are complete.
TASK_GENERATION_ENABLED=false

# Optional Cloudinary unsigned upload configuration (never put the API secret here).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
