# Copy to .env.naris. Use separate long hexadecimal passwords (letters/numbers only).
# This superuser is used only for initial database bootstrap/health checks.
NARIS_DB_ADMIN_USER=naris_admin
NARIS_DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_HEX_PASSWORD

# Least-privilege account used by the API and importer (not a PostgreSQL superuser).
NARIS_DB_USER=naris_app
NARIS_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_HEX_PASSWORD

NARIS_WEB_PORT=8081

# Production: set the exact public origin, e.g. https://cleaner.example.com
APP_ALLOWED_ORIGINS=http://localhost:8081
APP_TIME_ZONE=Africa/Cairo
PG_POOL_MAX=10

# Keep disabled until the PostgreSQL data import and same-date task reconciliation are complete.
TASK_GENERATION_ENABLED=false

# Optional Cloudinary unsigned upload configuration (never put the API secret here).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
